# Copy this file to .env and adjust the values.

# ── Vector store ──────────────────────────────────────────────────────────────
# Options: chroma (default, SQLite-backed), redis
VECTOR_STORE=chroma
CHROMA_DB_PATH=./data/chroma

# Redis — only needed when VECTOR_STORE=redis
# Requires Redis Stack: docker run -p 6379:6379 redis/redis-stack-server:latest
# VECTOR_STORE=redis
# REDIS_URL=redis://localhost:6379
# REDIS_INDEX_NAME=chatmyideas_idx

# ── Ollama ────────────────────────────────────────────────────────────────────
OLLAMA_HOST=http://localhost:11434
# Any model installed in Ollama. Small & good defaults:
#   lfm2.5-thinking:latest  — Liquid AI LFM 2.5 Thinking (default)
#   llama3.2                (~2 GB)
#   phi3:mini               (~2 GB)  — Microsoft Phi-3 Mini
#   gemma2:2b               (~1.6 GB)
OLLAMA_MODEL=lfm2.5-thinking:latest

# ── Embeddings ────────────────────────────────────────────────────────────────
# Local sentence-transformers model — downloaded automatically on first run.
EMBEDDING_MODEL=all-MiniLM-L6-v2
EMBEDDING_DIMENSION=384

# ── Chunking ──────────────────────────────────────────────────────────────────
CHUNK_SIZE=500
CHUNK_OVERLAP=50

# ── RAG ───────────────────────────────────────────────────────────────────────
TOP_K_CHUNKS=5

# ── App server ────────────────────────────────────────────────────────────────
APP_HOST=0.0.0.0
APP_PORT=8000
DEBUG=false
